---
import Base from '../layouts/Base.astro';
---
<Base>
  <p>Back-propagating to be a better dev :)</p>
  <p>current: SWE @ <a href="https://deepsource.com/" target="_blank" rel="noopener">DeepSource</a></p>

  <div class="bonsai-box" title="click to grow a new one">
    <pre class="bonsai" aria-hidden="true"></pre>
  </div>

  <script>
    // cbonsai-style tree, generated and grown in the browser
    (function () {
      const pre = document.querySelector('.bonsai');
      const box = document.querySelector('.bonsai-box');
      if (!pre || !box) return;

      const ROWS = 18, COLS = 44;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let timer = null;

      const R = (n) => Math.floor(Math.random() * n);
      const between = (a, b) => a + R(b - a + 1);

      function generate() {
        const grid = Array.from({ length: ROWS }, () => new Array(COLS).fill(null));
        const order = [];

        function put(r, c, ch, cls) {
          if (r < 0 || r >= ROWS || c < 0 || c >= COLS || grid[r][c]) return;
          grid[r][c] = { ch, cls, oi: order.length };
          order.push(grid[r][c]);
        }
        function leaves(r, c) {
          const spots = [[0, 0], [0, -1], [0, 1], [-1, 0], [-1, -1], [-1, 1]];
          for (const [dr, dc] of spots) if (Math.random() < 0.65) put(r + dr, c + dc, '&', 'leaf');
        }
        function tchar(dx, dy) {
          if (dy === 0) return dx === 0 ? '|' : '~';
          if (dx < 0) return '\\';
          if (dx > 0) return '/';
          return '|';
        }
        function grow(r, c, type, life) {
          let cr = r, cc = c;
          while (life > 0) {
            life--;
            let dx = 0, dy = 0;
            if (type === 'trunk') { dy = Math.random() < 0.75 ? -1 : 0; dx = between(-1, 1); }
            else if (type === 'left') { dy = Math.random() < 0.55 ? -1 : 0; dx = between(-2, 0); }
            else { dy = Math.random() < 0.55 ? -1 : 0; dx = between(0, 2); }
            cr += dy; cc += dx;
            if (cr < 0 || cc < 1 || cc >= COLS - 1) break;
            put(cr, cc, tchar(dx, dy), 'trunk');
            if (type === 'trunk' && life > 1 && life < 8 && Math.random() < 0.6) {
              grow(cr, cc, Math.random() < 0.5 ? 'left' : 'right', between(3, 6));
            }
            if (life <= 1) leaves(cr, cc);
          }
          leaves(cr, cc);
        }

        const baseC = COLS >> 1, baseR = ROWS - 4;
        const pot = ['\\_________/', ' \\=======/ ', '  `~~~~~`  '];
        const ps = Math.floor(baseC - pot[0].length / 2);
        pot.forEach((line, i) => {
          for (let j = 0; j < line.length; j++) if (line[j] !== ' ') put(ROWS - 3 + i, ps + j, line[j], 'trunk');
        });
        put(baseR, baseC, '|', 'trunk'); // seed so the trunk emerges from the pot, no gap
        grow(baseR, baseC, 'trunk', between(10, 14));
        return grid;
      }

      const esc = (ch) => (ch === '&' ? '&amp;' : ch === '<' ? '&lt;' : ch);

      function draw() {
        if (timer) { clearTimeout(timer); timer = null; }
        const grid = generate();
        let html = '';
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            const cell = grid[r][c];
            html += cell ? `<span class="cell ${cell.cls}" data-oi="${cell.oi}">${esc(cell.ch)}</span>` : ' ';
          }
          if (r < ROWS - 1) html += '\n';
        }
        pre.innerHTML = html;

        const spans = Array.from(pre.querySelectorAll('.cell')).sort((a, b) => a.dataset.oi - b.dataset.oi);
        if (reduce) { spans.forEach((s) => s.classList.add('show')); return; }
        let i = 0;
        (function step() {
          for (let n = 0; n < 2 && i < spans.length; n++, i++) spans[i].classList.add('show');
          if (i < spans.length) timer = setTimeout(() => requestAnimationFrame(step), 26);
        })();
      }

      draw();
      box.addEventListener('click', draw); // click to grow a fresh tree
    })();
  </script>
</Base>
